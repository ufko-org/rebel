; Simple testing suite
; Early naive version :)
; See also: .readme and .template files in this folder
;
; $Revision: 1.1 $ 
; $Author: Ufko $
;
; ---------------------------------------------------------------------
; (test "1: test 1" (+ 2 2) 4) ;-> pass
; (test "2: test 2" (+ 2 2) 6) ;-> fail
; = function that goes deep, comparing not only content but also types
; (test "3 test 3" (array 2 '(1 2)) '(1 2)) ;-> fail
; ---------------------------------------------------------------------
; test against regexp using re set to 1
; (test "4: regexp" 123 {\d\d\d} 1)
; (test "5: regexp" '(1 2 3) {\(\d \d \d\)} 1)
; ---------------------------------------------------------------------

; Global aliases and constants if needed
; ---------------------------------------------------------------------

; Macro functor
; ---------------------------------------------------------------------
(context 'test)
(mac (test:test name expr want (re 0))
  (set expr (eval expr))
  (set want (eval want))
  (if (= test:pass nil) (set test:pass 0))
  (if (= test:fail nil) (set test:fail 0))
  (++ test:cases)

  (if (= re 0)
    (if (= expr want)
      (do
        (++ test:pass)
        (prn (fmt "Test: %s\n\tpass: %s" 
          name (string expr))))
      (do
        (++ test:fail)
        (prn (fmt "Test: %s\n\tfail: want: %s got: %s" 
          name (string want) (string expr))))))

  (if (= re 1)
    (if (rx (string want) (string expr))
      (do
        (++ test:pass)
        (prn (fmt "Test: %s\n\tpass: %s" 
          name (string expr))))
      (do
        (++ test:fail)
        (prn (fmt "Test: %s\n\tfail: want: %s got: %s" 
          name (string want) (string expr))))))

)
