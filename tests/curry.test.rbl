; Test for function "curry"
; ------------------------------------------------------------
(load "testing.rbl")

; Curry arithmetic
; ------------------------------------------------------------
(test "1: curry with + and constant"
  (do
    (set f (curry + 10))
    (f 5)
  )
  15
)

; Curry inside keep
; ------------------------------------------------------------
(test "2: curry with match inside keep"
  (keep (curry match '(a *))
          '((a 10) (b 5) (a 3) (c 8) (a 9)))
  '((a 10) (a 3) (a 9))
)

; Curry inside drop
; ------------------------------------------------------------
(test "3: curry with match inside drop"
  (drop (curry match '(a *))
         '((a 10) (b 5) (a 3) (c 8) (a 9)))
  '((b 5) (c 8))
)

; Curry inside map
; ------------------------------------------------------------
(test "4: curry list constructor"
  (map (curry list 'x) (range 1 5))
  '((x 1) (x 2) (x 3) (x 4) (x 5))
)
