; Test for function "drop"
; ------------------------------------------------------------
(load "testing.rbl")

; Drop numbers
; ------------------------------------------------------------
(test "1: remove integers from mixed list"
  (= (drop int? '(1 1.1 2 2.2 3 3.3)) '(1.1 2.2 3.3))
  true
)

; Drop true values
; ------------------------------------------------------------
(test "2: remove true? values from list"
  (= (drop true? '(a nil b nil c nil)) '(nil nil nil))
  true
)
