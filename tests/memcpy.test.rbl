; Test for function "memcpy"
; ------------------------------------------------------------
(load "testing.rbl")

; Basic memory copy
; ------------------------------------------------------------
(test "1: memcpy copies 5 bytes from string to string"
  (do
    (set from "12345")
    (set to   "     ")
    (memcpy (address from) (address to) 5)
    (= from to)
  )
  true
)

; Copy shorter segment
; ------------------------------------------------------------
(test "2: memcpy copies first 3 bytes only"
  (do
    (set from "abcde")
    (set to   "xxxxx")
    (memcpy (address from) (address to) 3)
    (= to "abcxx")
  )
  true
)

; Idempotent when source and destination match
; ------------------------------------------------------------
(test "3: memcpy with same string leaves it unchanged"
  (do
    (set s "hello")
    (memcpy (address s) (address s) 5)
    (= s "hello")
  )
  true
)
