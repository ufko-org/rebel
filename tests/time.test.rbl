; Test for function "time"
; ------------------------------------------------------------
(load "testing.rbl")

; All ways to express 1970-1-1 00:00:00 must return 0
; ------------------------------------------------------------
(test "1: date-value epoch variants"
  (= 0
     (time 1970 1 1 0 0 0)
     (time (+ 1970) (+ 1) (+ 1) (+ 0) (+ 0) (+ 0))
     (time '(1970 1 1 0 0 0)))
  true
)
