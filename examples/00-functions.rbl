; Call by reference:
; ---------------------------------------------------------------------

; 1. using default functor
; default functor is always passed by reference (automatically)
; ---------------------------------------------------------------------
(set x:x 10)
(func (f p) 
  (set p 5))
(f x:x)
(println x:x) ;-> 5

; 2. using eval
; ---------------------------------------------------------------------
(set y 10)
; use _p suffix for param name to avoid conflict 
; with global symbol
(func (f y_p) 
  (set (eval y_p) 5))  
(f 'y)
(println y) ;-> 5

; 3. using macro
; nice, clean way
; ---------------------------------------------------------------------
(set z 10)
(mac (f z) 
  (set (eval z) 5))
(f z)
(println z) ;-> 5

; 4. using symbol as pointer
; we intentionally reuse a parameter name (p) that 
; conflicts with a global symbol (p) to demonstrate 
; call-by-reference using eval
; ---------------------------------------------------------------------
(set p 'x:x)
(func (f p) 
  (set (eval p) 35)) ; p points to x:x
(f p)
(println x:x) ;-> 35
